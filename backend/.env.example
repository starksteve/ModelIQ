# ============================================================
# ModelIQ — backend configuration
# Copy this file to .env and fill in ONE provider below.
# ============================================================

# ------------------------------------------------------------
# OPTION 1 (recommended, FREE): OpenAI-compatible provider
# Works with Google Gemini, Groq, OpenRouter, Mistral, Ollama...
# The app auto-detects this mode when OPENAI_BASE_URL is set.
# ------------------------------------------------------------

# --- Google Gemini (free tier, has BOTH chat + embeddings) ---
# Get a free key: https://aistudio.google.com/app/apikey
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=your-gemini-api-key-here
OPENAI_MODEL=gemini-2.0-flash
OPENAI_EMBEDDING_MODEL=text-embedding-004

# --- Groq (free tier, very fast; chat only, no embeddings) ---
# Get a free key: https://console.groq.com/keys
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your-groq-api-key-here
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (free models available; chat only) ---
# Get a free key: https://openrouter.ai/keys
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=your-openrouter-api-key-here
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------
# OPTION 2: Azure OpenAI (enterprise). Leave OPENAI_BASE_URL
# blank above to use this instead.
# ------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_API_KEY=
# CLIENT_ID=
# CLIENT_SECRET=
# TENANT_ID=
# OPENAI_PROJECT_ID=

# App port (optional)
# PORT=5000
